.power.on .core{border-color:var(--accent);box-shadow:0 0 40px -6px var(--accent),inset 0 0 26px -10px var(--accent)}
.power.wait .core{border-color:var(--busy);box-shadow:0 0 34px -8px var(--busy)}
.power:not(:disabled):hover .core{border-color:var(--accent-h)}
.power.wait .ticks{animation:spin 2.4s linear infinite;transform-origin:104px 104px}
@keyframes spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.power.wait .ticks{animation:none}}
.status{font:700 24px/1.1 var(--display);letter-spacing:.05em;text-transform:uppercase;margin-top:10px;text-align:center}
.status.on{color:var(--accent)}.status.wait{color:var(--busy)}
.detail{color:var(--muted);font-size:14px;text-align:center;min-height:21px;margin-top:2px}
.seg{display:grid;grid-template-columns:1fr 1fr;background:var(--field);border:1px solid var(--line);border-radius:9px;padding:3px;margin-top:16px;width:100%}
.seg button{border:0;background:none;color:var(--muted);font:600 14px/1.2 var(--display);letter-spacing:.06em;text-transform:uppercase;padding:9px 6px;border-radius:7px;cursor:pointer}
.seg button small{display:block;font:500 11px/1.3 var(--body);letter-spacing:0;text-transform:none}
.seg button.sel{background:var(--soft);color:var(--ink);box-shadow:inset 0 0 0 1px var(--line)}
.seg button:disabled{cursor:default;opacity:.55}
.k{font:600 12px/1 var(--display);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.usage{display:flex;align-items:baseline;justify-content:space-between;margin:8px 0 10px}
.usage b{font:700 30px/1 var(--display);letter-spacing:.02em}.usage span{color:var(--muted);font-size:14px}
.bar{height:8px;border-radius:99px;background:var(--field);border:1px solid var(--line);overflow:hidden}
.bar i{display:block;height:100%;width:0;background:var(--accent);border-radius:99px;transition:width .4s}
.bar.hi i{background:var(--warn)}.bar.full i{background:var(--bad)}
.meta{display:flex;justify-content:space-between;color:var(--muted);font-size:13px;margin-top:9px}
.meta em{font-style:normal;color:var(--ink)}
.code{display:flex;gap:8px;align-items:center;background:var(--field);border:1px solid var(--line);border-radius:8px;padding:8px 8px 8px 10px;margin:8px 0;font:12.5px/1.4 ui-monospace,"DejaVu Sans Mono",monospace;word-break:break-all}
.code span{flex:1}
.small{color:var(--muted);font-size:13px;margin:0}
footer{padding-top:14px;display:flex;align-items:center;justify-content:space-between;color:var(--muted);font-size:13px}
footer .who b{color:var(--ink);font-weight:600}
.credit{text-align:center;color:var(--grey);font-size:11px;letter-spacing:.04em;margin-top:10px}
[hidden]{display:none!important}
</style></head><body><div class="wrap">
<header>
  <svg width="34" height="38" viewBox="0 0 34 38" aria-hidden="true"><path d="M17 1 32 7v11c0 9.5-6.4 16.4-15 19C8.4 34.4 2 27.5 2 18V7z" fill="#15324f" stroke="#ff8a4c" stroke-width="2"/><path d="M11 17h12M17 11v12" stroke="#ff8a4c" stroke-width="2.4" stroke-linecap="round" opacity=".9"/></svg>
  <div class="brand">CloudLabs-VPN<small>Cloud Computing labs</small></div>
  <span class="pill" id="pill">Off</span>
</header>
<div id="banners"></div>

<section id="signin" hidden>
  <div class="card">
    <h1>Sign in</h1>
    <p class="sub">Use the username and password your instructor gave you.</p>
    <form id="form" autocomplete="on">
      <label for="user">Username</label>
      <input id="user" autocomplete="username" autocapitalize="off" spellcheck="false" required>
      <label for="pw">Password</label>
      <div class="pwrow"><input id="pw" type="password" autocomplete="current-password" required><button type="button" class="link" id="show">Show</button></div>
      <button class="btn" id="go">Sign in</button>
    </form>
  </div>
</section>

<section id="home" hidden>
  <div class="card stage">
    <button class="power" id="power" aria-label="Connect">
      <svg viewBox="0 0 208 208" aria-hidden="true"><g class="ticks" id="ticks"></g></svg>
      <span class="core"><svg width="54" height="54" viewBox="0 0 54 54" aria-hidden="true"><path id="glyph" d="M18 14a17 17 0 1 0 18 0M27 6v20" fill="none" stroke="#6886a6" stroke-width="4.5" stroke-linecap="round"/></svg></span>
    </button>
    <div class="status" id="status">Not connected</div>
    <div class="detail" id="detail"></div>
    <div class="seg" role="group" aria-label="Connection type">
      <button id="mFull" type="button">Full VPN<small>All traffic &middot; needs admin</small></button>
      <button id="mProxy" type="button">Proxy<small>Browser + terminal &middot; no admin</small></button>
    </div>
  </div>
  <div class="card" id="proxyCard" hidden>
    <div class="k">Use the proxy</div>
    <p class="small" style="margin-top:8px">Only apps set to use it go through the VPN. Paste this in your terminal for the AWS CLI, curl, git and pip:</p>
    <div class="code"><span id="exp"></span><button class="link" id="copy">Copy</button></div>
    <p class="small">Browser: set the proxy to <b style="color:var(--ink)">127.0.0.1</b> port <b style="color:var(--ink)" id="port"></b>, or start Chrome with <span style="font-family:ui-monospace,monospace" id="chrome"></span></p>
  </div>
  <div class="card">
    <div class="k">This month</div>
    <div class="usage"><b id="used">&ndash;</b><span id="limit"></span></div>
    <div class="bar" id="bar"><i id="fill"></i></div>
    <div class="meta"><span>Resets <em id="resets">&ndash;</em></span><span>Server <em id="server">&ndash;</em></span></div>
  </div>
</section>

<div style="flex:1"></div>
<footer id="foot" hidden><span class="who">Signed in as <b id="who"></b></span><span><button class="link" id="out">Sign out</button><button class="link" id="quit">Quit</button></span></footer>
<div class="credit">Made by Alaa Aladdin</div>
</div>
<script>
const key = location.hash.slice(1);
const $ = id => document.getElementById(id);
let S = null, mode = null, timer = null;
try { mode = localStorage.getItem("mode"); } catch (e) {}

async function api(path, body) {
  const r = await fetch(path, body === undefined ? {headers: {"X-Token": key}} :
    {method: "POST", headers: {"X-Token": key, "Content-Type": "application/json"}, body: JSON.stringify(body)});
  const d = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(d.error || ("HTTP " + r.status));
  return d;
}
function gb(n) { return (n / 1e9).toFixed(2); }
function day(s) { const d = new Date(s + "T00:00:00"); return isNaN(d) ? (s || "the 1st") : d.toLocaleDateString(undefined, {month: "long", day: "numeric"}); }
function banner(text, kind, title) {
  const b = document.createElement("div"); b.className = "banner" + (kind ? " " + kind : "");
  if (title) { const t = document.createElement("b"); t.textContent = title + " "; b.append(t); }
  b.append(text); $("banners").append(b);
}

// gauge ticks around the power button
(function () {
  const g = $("ticks"), ns = "http://www.w3.org/2000/svg";
  for (let i = 0; i < 60; i++) {
    const a = i * 6 * Math.PI / 180, long = i % 5 === 0, r1 = long ? 88 : 92, r2 = 100;
    const l = document.createElementNS(ns, "line");
    l.setAttribute("x1", 104 + r1 * Math.sin(a)); l.setAttribute("y1", 104 - r1 * Math.cos(a));
    l.setAttribute("x2", 104 + r2 * Math.sin(a)); l.setAttribute("y2", 104 - r2 * Math.cos(a));
    l.setAttribute("stroke-width", long ? 2.4 : 1.3); l.setAttribute("stroke-linecap", "round");
    g.append(l);
  }
})();

function render() {
  const s = S; if (!s) return;
  $("banners").replaceChildren();
  if (s.error) banner(s.error, "", "Problem:");
  if (s.offline) banner("Can't reach the CloudLabs-VPN server right now. Showing your last known details.", "warn", "Offline.");
  $("signin").hidden = s.signed_in; $("home").hidden = !s.signed_in; $("foot").hidden = !s.signed_in;
  const on = !!s.connected, wait = !!s.busy, st = on ? "on" : wait ? "wait" : "";
  $("pill").textContent = on ? (s.connected.proxy ? "Proxy on" : "VPN on") : wait ? "Working" : "Off";
  $("pill").className = "pill " + st;
  if (!s.signed_in) { $("go").disabled = false; return; }

  const m = s.me || {};
  $("who").textContent = m.name || "";
  if (mode !== "full" && mode !== "proxy") mode = s.can_full ? "full" : "proxy";
  if (on) mode = s.connected.proxy ? "proxy" : "full";
  $("mFull").className = mode === "full" ? "sel" : ""; $("mProxy").className = mode === "proxy" ? "sel" : "";
  $("mFull").disabled = $("mProxy").disabled = on || wait;
  if (!s.can_full) { $("mFull").disabled = true; $("mFull").title = "This PC has neither pkexec nor sudo, so use Proxy."; }

  const server = (m.server || {}).state || "unknown";
  const blocked = !!m.blocked, paused = server === "stopped" && !m.allow_wake;
  if (blocked && !on) banner("You've used all your data for this month. It resets on " + day(m.resets) + ".", "", "Limit reached.");
  else if (paused && !on) banner("The VPN server is paused. Ask your instructor to start it.", "warn", "Server paused.");

  const p = $("power"); p.className = "power " + st;
  p.disabled = wait || (!on && (blocked || paused));
  p.setAttribute("aria-label", on ? "Disconnect" : "Connect");
  const color = on ? "#ff8a4c" : wait ? "#5cc8ff" : "#6886a6";
  $("ticks").setAttribute("stroke", on || wait ? color : "#24496f");
  $("glyph").setAttribute("stroke", color);
  $("status").textContent = on ? "Connected" : wait ? (s.busy.startsWith("Disconnect") ? "Disconnecting" : s.busy.startsWith("Signing") ? "Signing out" : "Connecting") : "Not connected";
  $("status").className = "status " + st;
  $("detail").textContent = wait ? s.busy : on ? (s.connected.proxy ? "Proxy on 127.0.0.1:" + s.proxy_port : "All traffic goes through the VPN") + " \u00b7 " + s.connected.server : "Tap to connect";

  const port = s.proxy_port;
  $("proxyCard").hidden = !(on && s.connected.proxy);
  $("exp").textContent = `export HTTPS_PROXY=http://127.0.0.1:${port} HTTP_PROXY=http://127.0.0.1:${port} ALL_PROXY=socks5h://127.0.0.1:${port}`;
  $("port").textContent = port; $("chrome").textContent = `google-chrome --proxy-server=http://127.0.0.1:${port}`;

  const used = m.used || 0, lim = m.limit_gb || 0;
  $("used").textContent = gb(used) + " GB";
  $("limit").textContent = lim ? "of " + lim + " GB" : "no limit";
  const pct = lim ? Math.min(100, used / (lim * 1e9) * 100) : 0;
  $("fill").style.width = pct + "%";
  $("bar").className = "bar" + (pct >= 100 ? " full" : pct >= 80 ? " hi" : "");
  $("resets").textContent = day(m.resets);
  $("server").textContent = server;
}

async function poll() {
  clearTimeout(timer);
  try { S = await api("/api/state"); render(); }
  catch (e) { $("banners").replaceChildren(); banner("The CloudLabs-VPN app isn't running. Open it again from your apps menu.", "", "Closed."); }
  timer = setTimeout(poll, S && S.busy ? 800 : 2500);
}
async function act(path, body) {
  try { S = await api(path, body || {}); render(); } catch (e) { banner(e.message, "", "Problem:"); }
  poll();
}

$("form").addEventListener("submit", async e => {
  e.preventDefault(); $("go").disabled = true; $("go").textContent = "Signing in...";
  try { S = await api("/api/login", {username: $("user").value, password: $("pw").value}); $("pw").value = ""; render(); }
  catch (err) { $("banners").replaceChildren(); banner(err.message, "", "Couldn't sign in."); }
  $("go").disabled = false; $("go").textContent = "Sign in";
});
$("show").onclick = () => { const p = $("pw"), h = p.type === "password"; p.type = h ? "text" : "password"; $("show").textContent = h ? "Hide" : "Show"; };
$("power").onclick = () => S && (S.connected ? act("/api/disconnect") : act("/api/connect", {proxy: mode === "proxy"}));
function pick(m) { mode = m; try { localStorage.setItem("mode", m); } catch (e) {} render(); }
$("mFull").onclick = () => pick("full"); $("mProxy").onclick = () => pick("proxy");
$("copy").onclick = async () => { try { await navigator.clipboard.writeText($("exp").textContent); $("copy").textContent = "Copied"; setTimeout(() => $("copy").textContent = "Copy", 1500); } catch (e) {} };
$("out").onclick = () => act("/api/logout");
$("quit").onclick = async () => {
  if (S && S.connected && !confirm("Quit CloudLabs-VPN? The VPN stays connected until you open it again and disconnect.")) return;
  try { await api("/api/quit", {}); } catch (e) {}
  clearTimeout(timer); document.body.innerHTML = '<div class="wrap"><p class="sub" style="margin-top:40px;text-align:center">CloudLabs-VPN is closed. You can close this window.</p></div>';
};
poll();
</script></body></html>
"""

COMMANDS = {"gui": cmd_gui, "login": cmd_login, "logout": cmd_logout, "status": cmd_status, "connect": cmd_connect, "disconnect": cmd_disconnect}


def launch_note(cmd, text):
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, "errors.log"), "a") as f:
            f.write("%s  %s: %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), cmd, text) + os.linesep)
    except OSError:
        pass


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help", "help") else 2
    try:
        COMMANDS[argv[0]](argv[1:])
        return 0
    except Fail as e:
        print(e, file=sys.stderr)
        launch_note(argv[0], str(e))
        return 1
    except Exception as e:  # started from the apps menu there's no terminal, so leave a trace
        launch_note(argv[0], "%s: %s" % (type(e).__name__, e))
        raise
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
