#!/usr/bin/env python3
"""CloudLabs-VPN for Linux. Made by Alaa Aladdin.

  cloudlabs-vpn gui                  open the CloudLabs-VPN window
  cloudlabs-vpn login [username]     sign in with the username and password you were given
  cloudlabs-vpn connect              full VPN: all traffic goes through it (asks for sudo)
  cloudlabs-vpn connect --proxy      no admin rights needed: a local proxy for your browser and terminal
  cloudlabs-vpn disconnect
  cloudlabs-vpn status               connection, usage and limit
  cloudlabs-vpn logout
"""
import getpass, json, os, secrets, shutil, signal, subprocess, sys, threading, time, urllib.error, urllib.request, webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

APP = os.path.dirname(os.path.realpath(__file__))
SING_BOX = os.path.join(APP, "sing-box")
STATE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "cloudlabs-vpn")
SESSION, CONFIG, RUN, LOG, STOP, GUI = (os.path.join(STATE, f) for f in
                                        ("session.json", "config.json", "running.json", "cloudlabs.log", "stop", "gui.json"))
PROXY_PORT = 2080
UA = "CloudLabs-VPN-linux"
# runs sing-box as root and stops it when the user (who can't signal a root process) creates the stop file
ROOT_RUN = '"$1" run -c "$2" -D "$3" & p=$!; while kill -0 $p 2>/dev/null; do [ -e "$4" ] && kill $p; sleep 0.5; done'


class Fail(Exception):
    pass


def api_url():
    try:
        with open(os.path.join(APP, "api.json")) as f:
            return json.load(f)["api"].rstrip("/")
    except (OSError, ValueError, KeyError):
        raise Fail("This copy of CloudLabs-VPN has no server address. Ask for a new installer.")


def call(method, path, token=None, body=None):
    """Returns (status, data). Network problems raise Fail."""
    req = urllib.request.Request(api_url() + path, method=method, headers={"User-Agent": UA, "Content-Type": "application/json"},
                                 data=None if body is None else json.dumps(body).encode())
    if token:
        req.add_header("Authorization", "Bearer " + token)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # talk to the server directly, never through our own proxy
    try:
        with opener.open(req, timeout=20) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            data = json.loads(e.read() or b"{}")
        except ValueError:
            data = {}
        return e.code, data
    except (urllib.error.URLError, OSError) as e:
        raise Fail("Can't reach the CloudLabs-VPN server. Check your internet. (%s)" % getattr(e, "reason", e))


def err(status, data):
    return data.get("error") or "The server said no (HTTP %d)." % status


def write_private(path, obj):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def token():
    t = read_json(SESSION).get("token")
    if not t:
        raise Fail("You're not signed in. Run: cloudlabs-vpn login")
    return t


def me():
    status, data = call("GET", "/api/me", token())
    if status in (401, 403):
        sign_out()
        raise Fail(err(status, data) + " Sign in again.")
    if status != 200:
        raise Fail(err(status, data))
    return data


def gb(n):
    return "%.2f GB" % (n / 1e9)


# ------------------------------------------------------------------ engine

def build_config(vpn, proxy_mode):
    """Same settings as the Windows app; proxy mode swaps the tunnel for a local proxy."""
    if proxy_mode:
        inbound = {"type": "mixed", "tag": "proxy-in", "listen": "127.0.0.1", "listen_port": PROXY_PORT}
    else:
        inbound = {"type": "tun", "tag": "tun-in", "interface_name": "cloudlabs-vpn", "address": ["172.20.0.1/30"],
                   "mtu": 1400, "auto_route": True, "strict_route": True, "stack": "mixed"}
    return {
        "log": {"level": "warn", "timestamp": True},
        "dns": {"servers": [{"type": "https", "tag": "dns-remote", "server": "1.1.1.1", "detour": "proxy"},
                            {"type": "local", "tag": "dns-local"}],
                "final": "dns-remote", "strategy": "ipv4_only"},
        "inbounds": [inbound],
        "outbounds": [
            {"type": "vless", "tag": "proxy", "server": vpn["server"], "server_port": int(vpn["port"]), "uuid": vpn["uuid"],
             "flow": "xtls-rprx-vision",
             "tls": {"enabled": True, "server_name": vpn["sni"], "utls": {"enabled": True, "fingerprint": "chrome"},
                     "reality": {"enabled": True, "public_key": vpn["public_key"], "short_id": vpn["short_id"]}}},
            {"type": "direct", "tag": "direct"}],
        "route": {"rules": [{"action": "sniff"}, {"protocol": "dns", "action": "hijack-dns"},
                            {"ip_is_private": True, "outbound": "direct"}],
                  "final": "proxy", "auto_detect_interface": True, "default_domain_resolver": "dns-local"},
    }


def alive(pid):
    return os.path.exists("/proc/%d" % pid)


def running():
    r = read_json(RUN)
    return r if r.get("pid") and alive(r["pid"]) else None


def seen_ip(proxy_mode, timeout=8):
    """The public IP the internet sees, through the proxy in proxy mode."""
    handler = urllib.request.ProxyHandler({"https": "http://127.0.0.1:%d" % PROXY_PORT} if proxy_mode else {})
    req = urllib.request.Request("https://1.1.1.1/cdn-cgi/trace", headers={"User-Agent": UA})
    with urllib.request.build_opener(handler).open(req, timeout=timeout) as r:
        return dict(l.split("=", 1) for l in r.read().decode().splitlines() if "=" in l).get("ip", "")


def can_full():
    """The full VPN needs admin rights: already root, the desktop's password prompt, or sudo."""
    return os.geteuid() == 0 or bool(shutil.which("pkexec") or shutil.which("sudo"))


def admin_prefix(gui, say):
    """How to start sing-box as root. Tries what the PC has, best first, and says why when nothing works."""
    has_pkexec, has_sudo = shutil.which("pkexec"), shutil.which("sudo")
    if has_sudo and subprocess.run(["sudo", "-n", "true"], stdin=subprocess.DEVNULL, capture_output=True).returncode == 0:
        return ["sudo", "-n"], 15  # sudo already unlocked (or passwordless): no prompt needed
    if gui:
        if has_pkexec:
            say("Enter your computer password in the window that opens.")
            return ["pkexec"], 120  # time to type the password
        raise Fail("This PC has no admin password window (pkexec). Open a terminal and run: cloudlabs-vpn connect")
    if has_sudo:
        print("The full VPN needs admin rights: type your computer password.")
        r = subprocess.run(["sudo", "-v"], stderr=subprocess.PIPE, text=True)
        if r.returncode == 0:
            return ["sudo", "-n"], 15
        why = (r.stderr or "").strip().splitlines()
        if has_pkexec:
            print("sudo said no%s. Trying the desktop password window instead." % (": " + why[-1] if why else ""))
            return ["pkexec"], 120
        raise Fail("sudo refused%s. Your account may not have admin rights on this PC (check: groups). "
                   "Without them use: cloudlabs-vpn connect --proxy" % (": " + why[-1] if why else ""))
    if has_pkexec:
        return ["pkexec"], 120
    raise Fail("This PC has neither sudo nor pkexec, so the full VPN can't start. Use: cloudlabs-vpn connect --proxy")


def stop(r):
    if r.get("root"):
        open(STOP, "w").close()
    else:
        try:
            os.kill(r["pid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
    for _ in range(80):
        if not alive(r["pid"]):
            break
        time.sleep(0.1)
    remove(RUN)
    remove(STOP)


def connect(proxy_mode, gui=False, say=print):
    """Starts the VPN and returns the IP the internet now sees. gui=True asks for admin rights with the desktop prompt."""
    if running():
        raise Fail("Already connected. Disconnect first.")
    if not os.access(SING_BOX, os.X_OK):
        raise Fail("sing-box is missing from %s. Reinstall CloudLabs-VPN." % APP)
    m = me()
    if m.get("blocked"):
        raise Fail("You've used all your data for this month. It resets on %s." % m.get("resets", "the 1st"))
    state = m.get("server", {}).get("state")
    if state != "running":
        if state == "stopped" and m.get("allow_wake"):
            status, data = call("POST", "/api/wake", token(), {})
            if status != 200:
                raise Fail(err(status, data))
        elif state == "stopped":
            raise Fail("The VPN server is paused. Ask your instructor to start it.")
        say("Waiting for the VPN server to start (up to 3 minutes)...")
        for _ in range(36):
            time.sleep(5)
            m = me()
            if m.get("server", {}).get("state") == "running":
                break
        else:
            raise Fail("The VPN server didn't start. Try again in a minute.")
    vpn = m.get("vpn", {})
    if not vpn.get("server") or not vpn.get("uuid"):
        raise Fail("Couldn't get your VPN settings yet. Try again in a minute.")
    write_private(CONFIG, build_config(vpn, proxy_mode))
    remove(STOP)

    root = not proxy_mode and os.geteuid() != 0
    cmd, wait = [SING_BOX, "run", "-c", CONFIG, "-D", STATE], 15
    if root:
        pre, wait = admin_prefix(gui, say)
        cmd = pre + [shutil.which("sh") or "/bin/sh", "-c", ROOT_RUN, "cloudlabs-vpn", SING_BOX, CONFIG, STATE, STOP]
    with open(LOG, "ab") as log:
        p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    # sudo/pkexec stay alive exactly as long as sing-box, so their pid is the one to watch
    write_private(RUN, {"pid": p.pid, "proxy": proxy_mode, "root": root, "server": vpn["server"]})

    ip, deadline = "", time.time() + wait
    while time.time() < deadline:
        if p.poll() is not None:
            remove(RUN)
            if root and p.returncode in (126, 127):
                raise Fail("The admin password was cancelled or refused. If your account has no admin rights on this PC, use Proxy mode.")
            raise Fail("The VPN engine stopped right away: %s (full log: %s)" % (last_error(), LOG))
        try:
            ip = seen_ip(proxy_mode, timeout=4)
            if ip == vpn["server"]:
                say("Connected.")
                return ip
        except OSError:
            pass
        time.sleep(1)
    stop(read_json(RUN) or {"pid": p.pid})
    raise Fail("Started the engine, but traffic isn't going through the VPN%s. Details: %s" % (" (seen IP %s)" % ip if ip else "", LOG))


def last_error():
    """The last meaningful line sing-box wrote, to show instead of just pointing at the log."""
    try:
        with open(LOG, errors="replace") as f:
            lines = [l.strip() for l in f.readlines()[-40:] if l.strip()]
        bad = [l for l in lines if "FATAL" in l or "ERROR" in l or "denied" in l.lower() or "not authorized" in l.lower()]
        return (bad or lines or ["no details"])[-1][-300:]
    except OSError:
        return "no details"


def disconnect():
    r = running()
    if r:
        stop(r)
    return bool(r)


def sign_in(user, password):
    status, data = call("POST", "/api/login", body={"username": user.strip().lower(), "password": password})
    if status != 200:
        raise Fail(err(status, data))
    write_private(SESSION, {"token": data["token"], "name": data.get("name", user)})
    return data.get("name", user)


def sign_out():
    disconnect()
    for p in (SESSION, CONFIG):
        remove(p)


# ------------------------------------------------------------------ terminal commands

def proxy_help():
    return ("Only apps that use the proxy go through the VPN. For this terminal (AWS CLI, curl, git, pip):\n"
            "  export HTTPS_PROXY=http://127.0.0.1:%d HTTP_PROXY=http://127.0.0.1:%d ALL_PROXY=socks5h://127.0.0.1:%d\n"
            "In your browser, set the proxy to 127.0.0.1 port %d, or start one with it:\n"
            "  google-chrome --proxy-server=http://127.0.0.1:%d" % ((PROXY_PORT,) * 5))


def cmd_login(args):
    user = args[0] if args else input("Username: ")
    print("Signed in as %s." % sign_in(user, getpass.getpass("Password: ")))
    cmd_status([])


def cmd_logout(args):
    sign_out()
    print("Signed out.")


def cmd_status(args):
    r = running()
    print("Connection: " + (("connected, " + ("proxy on 127.0.0.1:%d" % PROXY_PORT if r["proxy"] else "full VPN")) if r else "not connected"))
    m = me()
    used, limit = m.get("used", 0), m.get("limit_gb", 0)
    print("Signed in:  " + m.get("name", ""))
    print("Used:       %s of %s this month (resets %s)" % (gb(used), "%g GB" % limit if limit else "no limit", m.get("resets", "on the 1st")))
    print("Server:     " + m.get("server", {}).get("state", "unknown"))
    if m.get("blocked"):
        print("You've used all your data for this month.")


def cmd_connect(args):
    proxy_mode = "--proxy" in args
    ip = connect(proxy_mode, say=lambda s: None if s == "Connected." else print(s))
    print("Connected. The internet now sees you as %s." % ip)
    if proxy_mode:
        print("\n" + proxy_help())


def cmd_disconnect(args):
    print("Disconnected." if disconnect() else "Not connected.")


# ------------------------------------------------------------------ window (a local page in the browser)

class Gui:
    def __init__(self):
        self.lock = threading.Lock()
        self.busy, self.error, self.me, self.me_at, self.offline = "", "", None, 0, False

    def state(self):
        signed_in = bool(read_json(SESSION).get("token"))
        if signed_in and time.time() - self.me_at > (5 if self.busy else 15):
            self.me_at = time.time()
            try:
                self.me, self.offline = me(), False
            except Fail as e:
                if not read_json(SESSION).get("token"):  # the server signed us out
                    self.me, self.error, signed_in = None, str(e), False
                else:
                    self.offline = True
        r = running()
        return {"signed_in": signed_in, "busy": self.busy, "error": self.error, "offline": self.offline, "me": self.me if signed_in else None,
                "connected": {"proxy": r["proxy"], "server": r.get("server", "")} if r else None,
                "can_full": can_full(), "proxy_port": PROXY_PORT}

    def run(self, label, fn):
        """Long actions run in the background; the page polls state() to follow them."""
        with self.lock:
            if self.busy:
                return
            self.busy, self.error = label, ""

        def work():
            try:
                fn()
            except Fail as e:
                self.error = str(e)
            except Exception as e:  # keep the window alive whatever happens
                self.error = "Something went wrong: %s" % e
            finally:
                self.busy, self.me_at = "", 0
        threading.Thread(target=work, daemon=True).start()

    def say(self, text):
        self.busy = text


def open_window(url):
    for b in ("google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "microsoft-edge", "brave-browser"):
        if shutil.which(b):  # an app-style window without tabs or address bar
            subprocess.Popen([b, "--app=" + url, "--window-size=440,780"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            return
    if shutil.which("xdg-open"):
        subprocess.Popen(["xdg-open", url], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif not webbrowser.open(url):
        raise Fail("Couldn't open a browser window. Open this address in your browser: " + url)


def ping(info):
    req = urllib.request.Request("http://127.0.0.1:%d/api/ping" % info["port"], headers={"X-Token": info["token"]})
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=2) as r:
            return r.status == 200
    except (OSError, ValueError):
        return False


def cmd_gui(args):
    info = read_json(GUI)
    if info.get("port") and ping(info):  # already open: just show it again
        open_window("http://127.0.0.1:%d/#%s" % (info["port"], info["token"]))
        return
    gui, key = Gui(), secrets.token_urlsafe(24)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else json.dumps(body).encode()
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'; font-src https://fonts.gstatic.com; "
                             "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com")
            self.end_headers()
            self.wfile.write(data)

        def allowed(self):
            # the key travels in a custom header, so other websites can't drive this (their requests can't set it)
            return self.headers.get("Host") == "127.0.0.1:%d" % port and secrets.compare_digest(self.headers.get("X-Token", ""), key)

        def do_GET(self):
            if self.path == "/":
                return self.reply(200, PAGE.encode(), "text/html; charset=utf-8")
            if not self.allowed():
                return self.reply(403, {"error": "forbidden"})
            if self.path == "/api/ping":
                return self.reply(200, {"ok": True})
            if self.path == "/api/state":
                return self.reply(200, gui.state())
            self.reply(404, {"error": "not found"})

        def do_POST(self):
            if not self.allowed():
                return self.reply(403, {"error": "forbidden"})
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            except ValueError:
                body = {}
            if self.path == "/api/login":
                try:
                    sign_in(str(body.get("username", "")), str(body.get("password", "")))
                    gui.error, gui.me_at = "", 0
                    return self.reply(200, gui.state())
                except Fail as e:
                    return self.reply(400, {"error": str(e)})
            if self.path == "/api/connect":
                gui.run("Connecting...", lambda: connect(bool(body.get("proxy")), gui=True, say=gui.say))
            elif self.path == "/api/disconnect":
                gui.run("Disconnecting...", disconnect)
            elif self.path == "/api/logout":
                gui.run("Signing out...", sign_out)
            elif self.path == "/api/quit":
                threading.Thread(target=httpd.shutdown, daemon=True).start()
            else:
                return self.reply(404, {"error": "not found"})
            self.reply(200, gui.state())

    httpd = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    port = httpd.server_address[1]
    write_private(GUI, {"port": port, "token": key})
    url = "http://127.0.0.1:%d/#%s" % (port, key)  # the key sits after '#', so it never reaches a server or a log
    open_window(url)
    print("CloudLabs-VPN is open in your browser: %s\nClosing the window keeps the VPN as it is. Quit from the window, or press Ctrl+C here." % url)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        remove(GUI)


